#!/usr/bin/env bash
set -e

_err() {
    echo "ERROR: $*" >&2
    exit 1
}

_warn() {
    echo "WARNING: $*" >&2
}

show_help() {
    echo "Usage: run_pipeline [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --size str                   Map size: 'center' or 'full' (default: full)"
    echo "  --help                       Show this help message"
    echo ""
    echo "Optional noise options:"
    echo "  --noise_type str             Type of noise: 'gauss', 'multiplicative', 'aggregation', 'mislabelling', 'missingness', 'geometric'"
    echo "  --noise_source str           Target dataset: 'ndvi', 'uhei', 'land_use', 'trees', 'num_areas', 'green_area', 'ext_space', 'street_space', 'population_density'"
    echo "  --noise_level str            Noise severity: '1', '2', '3', '4', '5'"
    echo "  --aggregation_method str     Method for aggregation noise: 'mean', 'median'"
    echo "  --geometric_method str       Method for geometric noise: 'shrinking' or 'warping'"
    echo ""
    echo "Notes:"
    echo "- When --noise_type is 'aggregation' you MUST provide --aggregation_method."
    echo "- When --noise_type is 'aggregation' the --noise_level argument is NOT used/passed."
    echo "Example:"
    echo ">> grid_creation --size full --noise_type aggregation --noise_source uhei --aggregation_method mean"    
    exit 0
}

# ============================
# Default values
# ============================

SIZE="full"
NOISE_TYPE=""
NOISE_SOURCE=""
NOISE_LEVEL=""
AGGREGATION_METHOD=""

# ============================
# Parse parameters
# ============================

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --size)
            SIZE="$2"
            shift
            ;;
        --noise_type)
            NOISE_TYPE="$2"
            shift
            ;;
        --noise_source)
            NOISE_SOURCE="$2"
            shift
            ;;
        --noise_level)
            NOISE_LEVEL="$2"
            shift
            ;;
        --aggregation_method)
            AGGREGATION_METHOD="$2"
            shift
            ;;
        --help|-h)
            show_help
            ;;
        *)
            echo "Unknown parameter: $1"
            show_help
            ;;
    esac
    shift
done

# ============================
# Enforce rules
# ============================

if [[ -n "${NOISE_TYPE}" ]]; then

    if [[ -z "${NOISE_SOURCE}" ]]; then
        echo "Error: --noise_source is required when --noise_type is provided." >&2
        exit 1
    fi
    case "${NOISE_TYPE}" in
        gauss)
            if [[ "${NOISE_SOURCE}" != "ndvi" && "${NOISE_SOURCE}" != "uhei" && "${NOISE_SOURCE}" != "num_areas" && "${NOISE_SOURCE}" != "green_area" && "${NOISE_SOURCE}" != "ext_space" && "${NOISE_SOURCE}" != "street_space" && "${NOISE_SOURCE}" != "population_density" ]]; then
                _err "--noise_type '${NOISE_TYPE}' can only be used with --noise_source 'uhei', 'ndvi', 'num_areas', 'green_area', 'ext_space', 'street_space' or 'population_density'."
            fi
            if [[ -z "${NOISE_LEVEL}" ]]; then
                _err "--noise_level is required when --noise_type is 'gauss'."
            fi
            if [[ "${NOISE_LEVEL}" == "5" && "${NOISE_SOURCE}" == "num_areas" ]]; then
                _err "--noise_level can't be 5 when --noise_source is 'num_areas' and noise_type is gauss."
            fi
            if [[ -n "${AGGREGATION_METHOD}" ]]; then
                _warn "--aggregation_method is ignored when --noise_type is not 'aggregation'."
            fi
            ;;
        geometric)
            if [[ "${NOISE_SOURCE}" != "green_area" && "${NOISE_SOURCE}" != "ext_space" && "${NOISE_SOURCE}" != "street_space" ]]; then
                _err "--noise_type '${NOISE_TYPE}' can only be used with --noise_source 'green_area', 'ext_space' or 'street_space'."
            fi
            if [[ -z "${NOISE_LEVEL}" ]]; then
                _err "--noise_level is required when --noise_type is 'geometric'."
            fi
            if [[ -n "${AGGREGATION_METHOD}" ]]; then
                _warn "--aggregation_method is ignored when --noise_type is not 'aggregation'."
            fi
            ;;
        multiplicative)
            if [[ "${NOISE_SOURCE}" != "ndvi" && "${NOISE_SOURCE}" != "uhei" && "${NOISE_SOURCE}" != "green_area" && "${NOISE_SOURCE}" != "ext_space" && "${NOISE_SOURCE}" != "street_space" && "${NOISE_SOURCE}" != "population_density" ]]; then
                _err "--noise_type '${NOISE_TYPE}' can only be used with --noise_source 'uhei', 'ndvi', 'green_area', 'ext_space', 'street_space' or 'population_density'."
            fi
            if [[ -z "${NOISE_LEVEL}" ]]; then
                _err "--noise_level is required when --noise_type is 'multiplicative'."
            fi
            if [[ -n "${AGGREGATION_METHOD}" ]]; then
                _warn "--aggregation_method is ignored when --noise_type is not 'aggregation'."
            fi
            ;;
        aggregation)
            if [[ -z "${AGGREGATION_METHOD}" ]]; then
                _err "--aggregation_method is required when --noise_type is 'aggregation'."
            fi
            if [[ "${NOISE_SOURCE}" != "ndvi" && "${NOISE_SOURCE}" != "uhei" ]]; then
                _err "--noise_type 'aggregation' can only be used with --noise_source 'uhei' or 'ndvi'."
            fi
            if [[ -n "${NOISE_LEVEL}" ]]; then
                _warn "--noise_level is ignored when --noise_type is 'aggregation'."
            fi
            ;;
        missingness)
            if [[ "${NOISE_SOURCE}" != "trees" && "${NOISE_SOURCE}" != "num_areas" && "${NOISE_SOURCE}" != "population_density" ]]; then
                _err "--noise_type 'missingness' can only be used with --noise_source 'trees', 'num_areas' or 'population_density'."
            fi
            if [[ -z "${NOISE_LEVEL}" ]]; then
                _err "--noise_level is required when --noise_type is 'missingness'."
            fi
            if [[ -n "${AGGREGATION_METHOD}" ]]; then
                _warn "--aggregation_method is ignored when --noise_type is not 'aggregation'."
            fi
            ;;
        mislabelling)
            if [[ "${NOISE_SOURCE}" != "land_use" && "${NOISE_SOURCE}" != "population_density" ]]; then
                _err "--noise_type 'mislabelling' can only be used with --noise_source 'land_use' or 'population_density'."
            fi
            if [[ -z "${NOISE_LEVEL}" ]]; then
                _err "--noise_level is required when --noise_type is 'mislabelling'."
            fi
            if [[ -n "${AGGREGATION_METHOD}" ]]; then
                _warn "--aggregation_method is ignored when --noise_type is not 'aggregation'."
            fi
            ;;
        *)
            _err "Unknown --noise_type: '${NOISE_TYPE}'. Allowed: gauss, multiplicative, aggregation, missingness, mislabelling, geometric."
            ;;
    esac
fi


# ============================
# Run the script
# ============================

echo "Running grid_creation.py..."

if [[ "${NOISE_TYPE}" == "aggregation" ]]; then
    python3 src/grid_creation.py \
        --size "${SIZE}" \
        --noise_type "${NOISE_TYPE}" \
        --noise_source "${NOISE_SOURCE}" \
        --aggregation_method "${AGGREGATION_METHOD}"
elif [[ "${NOISE_TYPE}" == "" ]]; then
    python3 src/grid_creation.py \
        --size "${SIZE}"
else
    python3 src/grid_creation.py \
        --size "${SIZE}" \
        --noise_type "${NOISE_TYPE}" \
        --noise_source "${NOISE_SOURCE}" \
        --noise_level "${NOISE_LEVEL}"
fi

echo "Grid created successfully!"